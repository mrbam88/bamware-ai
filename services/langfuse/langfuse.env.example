# Template only. The real file is ~/.config/bamware/langfuse.env (chmod 600),
# generated by init-secrets.sh. Never commit values.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=   # = MINIO_ROOT_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=   # = MINIO_ROOT_PASSWORD
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=   # = MINIO_ROOT_PASSWORD
REDIS_AUTH=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=                               # 64 hex chars
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false
# Headless init (first boot only): org, project, API keys, first user.
LANGFUSE_INIT_ORG_ID=bamware
LANGFUSE_INIT_ORG_NAME=Bamware
LANGFUSE_INIT_PROJECT_ID=hermes
LANGFUSE_INIT_PROJECT_NAME=Hermes assistant
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=             # pk-lf-...
LANGFUSE_INIT_PROJECT_SECRET_KEY=             # sk-lf-...
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
